# Copy to apps/web/.env.local
MONGODB_URI=mongodb://127.0.0.1:27017/nexus-twin
AUTH_SECRET=dev-secret-change-me-to-a-long-random-string
NEXTAUTH_SECRET=dev-secret-change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:4090
NEXT_PUBLIC_APP_URL=http://localhost:4090
AUTH_URL=http://localhost:4090

# Google Gemini — used only when user asks AI questions
# Quota watchdog rotates through these keys in a loop on 429 / quota errors.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Or a comma-separated list: GEMINI_API_KEYS=keyA,keyB,keyC
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_2=gemini-3.5-flash-lite
GEMINI_MODEL_3=gemini-3.1-flash-lite
# Or: GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.8-flash,gemini-flash-latest
# Client also auto-discovers remaining text models from the Gemini API.
