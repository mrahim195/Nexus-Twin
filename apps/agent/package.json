{
  "name": "@nexus-twin/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:electron": "electron electron/main.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@nexus-twin/config": "workspace:*",
    "@nexus-twin/types": "workspace:*",
    "@nexus-twin/validation": "workspace:*",
    "systeminformation": "^5.23.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
