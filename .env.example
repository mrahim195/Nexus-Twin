# =============================================================================
# NEXUS//TWIN — Environment Variables
# Copy to .env / apps/web/.env.local and fill in values. Never commit secrets.
# =============================================================================

# --- MongoDB (server only — never expose to browser or agent) ---
MONGODB_URI=mongodb://127.0.0.1:27017/nexus-twin
MONGODB_DB=nexus-twin

# --- Web app (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:4090
NEXT_PUBLIC_APP_NAME=NEXUS//TWIN

# Auth (NextAuth / Auth.js)
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:4090

# Optional OAuth providers
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- AI (server only — called on user request, never continuous) ---
# Google Gemini (preferred)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Or: GEMINI_API_KEYS=keyA,keyB,keyC
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_2=gemini-3.5-flash-lite
GEMINI_MODEL_3=gemini-3.1-flash-lite

# --- Agent (apps/agent/.env) ---
NEXUS_API_URL=http://localhost:4090
# Device credentials are stored locally after pairing — do not put them here
# NEXUS_DEVICE_ID=
# NEXUS_DEVICE_TOKEN=

# Heartbeat / online detection (seconds)
NEXUS_HEARTBEAT_INTERVAL_SEC=20
NEXUS_OFFLINE_TIMEOUT_SEC=60

# Collection intervals (seconds)
NEXUS_INTERVAL_CPU_RAM_SEC=5
NEXUS_INTERVAL_NETWORK_SEC=5
NEXUS_INTERVAL_DISK_SEC=15
NEXUS_INTERVAL_PROCESS_SEC=20
NEXUS_INTERVAL_GPU_SEC=10
