{
  "name": "nexus-twin",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS//TWIN — Personal computer digital twin, real-time monitoring & AI diagnostics",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@nexus-twin/web",
    "dev:agent": "turbo run dev --filter=@nexus-twin/agent",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
